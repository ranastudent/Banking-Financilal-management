enum MonitoringEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum MonitoringSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudDetectionSource {
  PHASE32_RULE
  MONITORING_RULE
  BEHAVIORAL_ANALYTICS
  STATISTICAL_ANOMALY
  ML_MODEL
  MANUAL_REVIEW
}

enum FraudAlertStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  ESCALATED
  FALSE_POSITIVE
}

enum FraudCaseStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  PENDING_INFORMATION
  ESCALATED
  RESOLVED
  CLOSED
}

enum FraudCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudCaseResolution {
  CONFIRMED_FRAUD
  NO_FRAUD
  INCONCLUSIVE
  DUPLICATE
  OTHER
}

enum FraudEvidenceType {
  DOCUMENT
  IMAGE
  TRANSACTION_REFERENCE
  SYSTEM_LOG
  EXTERNAL_REFERENCE
  OTHER
}

enum FraudModelStatus {
  DRAFT
  VALIDATING
  APPROVED
  DEPLOYED
  DISABLED
  RETIRED
}

model MonitoringEvent {
  id            String                @id @default(uuid()) @db.Uuid
  eventKey      String                @unique @map("event_key")
  eventType     String                @map("event_type")
  schemaVersion Int                   @default(1) @map("schema_version")
  status        MonitoringEventStatus @default(PENDING)
  transactionId String?               @map("transaction_id") @db.Uuid
  accountId     String?               @map("account_id") @db.Uuid
  userId        String?               @map("user_id") @db.Uuid
  correlationId String?               @map("correlation_id")
  source        String?
  occurredAt    DateTime              @map("occurred_at")
  payload       Json
  attempts      Int                   @default(0)
  lastError     String?               @map("last_error")
  receivedAt    DateTime              @default(now()) @map("received_at")
  processedAt   DateTime?             @map("processed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  transaction    Transaction?              @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  account        Account?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user           User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  processingLogs MonitoringProcessingLog[]
  anomalyResults AnomalyDetectionResult[]
  predictions    FraudPrediction[]
  alerts         FraudAlert[]

  decisionExplanations TransactionDecisionExplanation[]

  @@index([status, createdAt])
  @@index([eventType, occurredAt])
  @@index([accountId, occurredAt])
  @@index([userId, occurredAt])
  @@index([transactionId])
  @@index([correlationId])
  @@map("monitoring_events")
}

