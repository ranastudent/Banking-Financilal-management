  READ
}

model OutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  eventType   String            @map("event_type")
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  publishedAt DateTime?         @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model BackgroundReport {
  id          String   @id @default(uuid()) @db.Uuid
  reportType  String   @map("report_type")
  dedupeKey   String   @unique @map("dedupe_key")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  payload     Json
  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([reportType, generatedAt])
  @@map("background_reports")
}

enum RiskLevel {
  LOW
  HIGH
}

enum RiskDecision {
  APPROVE
  HOLD
}

enum RiskReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum RiskReviewDecision {
  APPROVED
  REJECTED
}

model RiskAnalysis {
  id            String @id @default(uuid()) @db.Uuid
  transactionId String @unique @map("transaction_id") @db.Uuid

  // Risk assessment
  riskScore Int          @default(0) @map("risk_score")
  riskLevel RiskLevel    @map("risk_level")
  decision  RiskDecision @default(APPROVE)

  // Administrative review
  reviewStatus RiskReviewStatus @default(NOT_REQUIRED) @map("review_status")

  // Assessment explanation and engine version
  reasons       Json
  engineVersion String @default("rules-v1") @map("engine_version")

  // Timestamps
  analyzedAt DateTime @default(now()) @map("analyzed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviews     RiskReview[]

  decisionExplanations TransactionDecisionExplanation[]

  @@index([riskLevel, analyzedAt])
  @@index([decision, analyzedAt])
  @@index([reviewStatus, analyzedAt])
  @@map("risk_analyses")
}

model RiskReview {
  id             String @id @default(uuid()) @db.Uuid
  riskAnalysisId String @map("risk_analysis_id") @db.Uuid
  reviewerId     String @map("reviewer_id") @db.Uuid

  decision  RiskReviewDecision
  comment   String?
  requestId String?            @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  riskAnalysis RiskAnalysis @relation(fields: [riskAnalysisId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer     User         @relation("RiskReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([riskAnalysisId, createdAt])
  @@index([reviewerId, createdAt])
  @@index([decision, createdAt])
  @@index([requestId])
  @@map("risk_reviews")
}

