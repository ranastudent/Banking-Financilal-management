// -----------------------------------------------------------------------------
// CUSTOMER-FACING TRANSACTION DECISION EXPLANATIONS
// Shared by Phase 32 Risk Detection and Phase 33 Fraud Monitoring.
//
// These records are customer-safe historical snapshots. They explain decisions
// but do not themselves authorize, reject, hold, release, or reverse funds.
// -----------------------------------------------------------------------------

enum DecisionExplanationPhase {
  PHASE32
  PHASE33
  SHARED
}

enum DecisionExplanationSource {
  PHASE32_RISK_ENGINE
  PHASE33_MONITORING
  TRANSACTION_VALIDATION
  COMPLIANCE_REVIEW
  MANUAL_REVIEW
  SYSTEM_VALIDATION
}

enum CustomerTransactionDecision {
  APPROVED
  ON_HOLD
  REJECTED
  CANCELLED
  NEEDS_VERIFICATION
  PROCESSING
}

enum TransactionExplanationStatus {
  ACTIVE
  SUPERSEDED
  WITHDRAWN
}

model TransactionDecisionExplanation {
  id            String @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  customerId    String @map("customer_id") @db.Uuid

  phase           DecisionExplanationPhase
  source          DecisionExplanationSource
  decision        CustomerTransactionDecision
  decisionVersion Int                          @default(1) @map("decision_version")
  status          TransactionExplanationStatus @default(ACTIVE)

  riskAnalysisId    String? @map("risk_analysis_id") @db.Uuid
  monitoringEventId String? @map("monitoring_event_id") @db.Uuid
  fraudAlertId      String? @map("fraud_alert_id") @db.Uuid

  customerTitle   String @map("customer_title")
  customerMessage String @map("customer_message")

  reasonCodes     Json  @map("reason_codes")
  requiredActions Json? @map("required_actions")

  // Must be derived from the authoritative transaction and ledger state.
  // Never infer fund movement solely from a risk decision or fraud alert.
  transactionImpact Json @map("transaction_impact")

  publicReference String @unique @map("public_reference")
  locale          String @default("en")

  decisionAt DateTime @default(now()) @map("decision_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  riskAnalysis RiskAnalysis? @relation(fields: [riskAnalysisId], references: [id], onDelete: SetNull)

  monitoringEvent MonitoringEvent? @relation(fields: [monitoringEventId], references: [id], onDelete: SetNull)

  fraudAlert FraudAlert? @relation(fields: [fraudAlertId], references: [id], onDelete: SetNull)

  @@unique([transactionId, decisionVersion])
  @@index([customerId, createdAt])
  @@index([transactionId, status])
  @@index([decision, createdAt])
  @@index([phase, createdAt])
  @@index([source, createdAt])
  @@map("transaction_decision_explanations")
}
