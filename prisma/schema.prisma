  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFORMATION
  EXPIRED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  NEEDS_MORE_INFORMATION
}

enum ReserveMovementType {
  CUSTOMER_FX_PURCHASE
  CUSTOMER_FX_SELL
  EXTERNAL_SETTLEMENT
  ADMIN_ADJUSTMENT
  OPENING_BALANCE
}

enum BeneficiaryType {
  INTERNAL
  EXTERNAL
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PaymentProvider {
  INTERNAL
  BKASH
  NAGAD
  ROCKET
  PAYPAL
  PAYONEER
  WISE
}

enum ExternalProviderTransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  REGISTRATION_OTP
  EMAIL_VERIFICATION
  TRANSACTION
  FX_REQUEST
  FX_APPROVAL
  SECURITY
  SYSTEM
}

