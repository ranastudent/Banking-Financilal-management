PORT=5000

DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

REDIS_URL="rediss://default:password@host:6379"

JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="change-this-password"

CORS_ORIGINS="http://localhost:5173"

GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=5

TRANSFER_RATE_LIMIT_WINDOW_MS=900000
TRANSFER_RATE_LIMIT_MAX=20

TRANSACTION_HISTORY_RATE_LIMIT_WINDOW_MS=900000
TRANSACTION_HISTORY_RATE_LIMIT_MAX=60

BODY_SIZE_LIMIT=1mb
# Phase 23 — Background jobs
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
RISK_ANALYSIS_WINDOW_MINUTES=60
RISK_ANALYSIS_MAX_TRANSFERS_PER_WINDOW=10
DAILY_REPORT_CRON="0 1 * * *"
