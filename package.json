{
  "name": "banking-platform-backend",
  "version": "1.0.0",
  "description": "Production-style multi-currency banking and financial management backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:run": "vitest run",
    "worker": "node dist/jobs/worker.js",
    "worker:dev": "tsx src/jobs/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test:watch": "vitest"
  },
  "keywords": [
    "banking",
    "finance",
    "backend",
    "nodejs",
    "typescript",
    "postgresql",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/k6": "^2.2.1",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.2"
  }
}
