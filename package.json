{
  "name": "banking-platform-backend",
  "version": "1.0.0",
  "description": "Production-style multi-currency banking and financial management backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "banking",
    "finance",
    "backend",
    "nodejs",
    "typescript",
    "postgresql",
    "redis"
  ],
  "author": "",
  "license": "ISC",
